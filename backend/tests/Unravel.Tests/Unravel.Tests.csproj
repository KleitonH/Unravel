<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- PR 34e — silencia CS0618 (Obsolete) globalmente neste projeto.
         Os ChallengeForge*Tests/ClozeStrategyTests/etc. cobrem strategies
         template marcadas [Obsolete] em PR 34e: ainda valiosos pra
         garantir que a tipagem/lógica não regrediu enquanto as classes
         existirem (removeremos junto delas num futuro PR de cleanup
         final). Sem este NoWarn cada test file precisaria de pragma
         próprio — barulho que não agrega nada. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- PR 28 — KnowledgeImporter testa upsert real contra DbContext.
         InMemory ignora unique-filtered-index do Postgres, mas cobre
         o happy path da idempotência (slug → mesmo Id). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Unravel.Domain\Unravel.Domain.csproj" />
    <ProjectReference Include="..\..\src\Unravel.Application\Unravel.Application.csproj" />
    <ProjectReference Include="..\..\src\Unravel.Infrastructure\Unravel.Infrastructure.csproj" />
  </ItemGroup>

</Project>

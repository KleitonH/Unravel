<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.0.3" />

    <!-- PR 18 — MiniLM embedder via ONNX Runtime + tokenizer Hugging Face.
         Ambos com binários nativos pré-compilados pra Linux/Windows/Mac. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.18.0" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.0.5" />
    <!-- PR 33b — DLL nativa hf_tokenizers.dll. Sem isso, Tokenizers.DotNet
         lança DllNotFoundException no primeiro Encode. Mantém só a
         variante Windows; pra cross-platform adicionar .linux/.osx. -->
    <PackageReference Include="Tokenizers.DotNet.runtime.win" Version="1.0.5" />

    <!-- PR 20 — LLamaSharp (.NET binding p/ llama.cpp). Backend CPU-only
         por default; trocar por Cuda12/Vulkan/Metal sem mudar código. -->
    <PackageReference Include="LLamaSharp" Version="0.18.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.18.0" />

    <!-- PR 28 — KnowledgeImporter lê markdown com frontmatter YAML do diretório
         backend/knowledge/. Markdig só pra normalizar/strip de markdown quando
         indexarmos texto puro (claim extractor); YamlDotNet pro frontmatter. -->
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="YamlDotNet" Version="15.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unravel.Application\Unravel.Application.csproj" />
    <ProjectReference Include="..\Unravel.Domain\Unravel.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Migrations\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Unravel.Tests" />
  </ItemGroup>

</Project>

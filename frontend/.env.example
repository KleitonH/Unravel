# Frontend (Vite) — variáveis de ambiente. Copie para `.env` e ajuste.
# Só variáveis com prefixo VITE_ chegam ao browser.

# URL base da API. Default (sem setar) = http://localhost:5000
VITE_API_URL=http://localhost:5000

# (Opcional) Base URL dos assets raster do NAVI (cosméticos paper-doll).
# Vazio = usa os arquivos bundlados em src/components/navi/assets/.
# Setado = serve de CDN/storage externo `${VITE_NAVI_CDN}/<slug>.<ext>`
#          (suba os mesmos arquivos da pasta pro bucket). Útil quando o front
#          é servido pela própria VM — ex.: Cloudflare R2 (egress grátis):
# VITE_NAVI_CDN=https://pub-xxxxx.r2.dev/navi
